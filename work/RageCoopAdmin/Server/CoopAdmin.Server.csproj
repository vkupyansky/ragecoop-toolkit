<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CoopAdmin</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.3" />
    <Compile Include="../Shared/VehicleAppearance.cs" Link="Shared/VehicleAppearance.cs" />
    <Compile Include="../Shared/WorldOptions.cs" Link="Shared/WorldOptions.cs" />
    <Compile Include="../Shared/EngineTransportGuard.cs" Link="Shared/EngineTransportGuard.cs" />
    <Compile Include="../Shared/EngineCodecGuard.cs" Link="Shared/EngineCodecGuard.cs" />
    <Compile Include="../Shared/EngineFragmentGuard.cs" Link="Shared/EngineFragmentGuard.cs" />
    <Compile Include="../Shared/EngineLoggerGuard.cs" Link="Shared/EngineLoggerGuard.cs" />
    <Compile Include="../Shared/EngineWorkerGuard.cs" Link="Shared/EngineWorkerGuard.cs" />
    <Reference Include="Lidgren.Network">
      <HintPath>$(RageCoopClientDir)/Lidgren.Network.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RageCoop.Server">
      <HintPath>$(RageCoopServerDir)/RageCoop.Server.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RageCoop.Core">
      <HintPath>$(RageCoopServerDir)/RageCoop.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ScriptHookVDotNet3">
      <HintPath>$(RageCoopServerDir)/ScriptHookVDotNet3.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="ValidateRageCoopReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(RageCoopServerDir)' == '' Or !Exists('$(RageCoopServerDir)/RageCoop.Core.dll') Or !Exists('$(RageCoopServerDir)/ScriptHookVDotNet3.dll')" Text="Set RageCoopServerDir in References.props to the compatible RageCoop server directory." />
    <Error Condition="!Exists('$(RageCoopServerDir)/RageCoop.Server.dll')" Text="RageCoopServerDir must contain RageCoop.Server.dll." />
  </Target>
</Project>
