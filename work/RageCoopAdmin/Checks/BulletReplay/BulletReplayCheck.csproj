<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.3" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Compile Include="Program.cs" />
    <Compile Include="../../Client/RuntimeEntityLookup.cs" Link="RuntimeEntityLookup.cs" />
    <Compile Include="../../Client/VehicleBulletRange.cs" Link="VehicleBulletRange.cs" />
    <Compile Include="../../Client/VehicleBulletReplayGuard.cs" Link="VehicleBulletReplayGuard.cs" />
    <Compile Include="../../Client/AppearanceEditQueue.cs" Link="AppearanceEditQueue.cs" />
    <Compile Include="../../Client/VehicleAppearanceRuntimeGuard.cs" Link="VehicleAppearanceRuntimeGuard.cs" />
    <Compile Include="../../Shared/VehicleAppearance.cs" Link="VehicleAppearance.cs" />
    <Reference Include="RageCoop.Client"><HintPath>$(RageCoopClientDir)/RageCoop.Client.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="RageCoop.Core"><HintPath>$(RageCoopServerDir)/RageCoop.Core.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="ScriptHookVDotNet3"><HintPath>$(RageCoopServerDir)/ScriptHookVDotNet3.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Lidgren.Network"><HintPath>$(RageCoopClientDir)/Lidgren.Network.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
