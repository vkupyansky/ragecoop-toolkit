<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ClientResourcePath>$(MSBuildThisFileDirectory)../../Client/bin/$(Configuration)/net48/RageCoopAdmin.Client.dll</ClientResourcePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.3" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Content Include="$(ClientResourcePath)" Link="RageCoopAdmin.Client.dll" CopyToOutputDirectory="PreserveNewest" />
    <Reference Include="RageCoop.Client"><HintPath>$(RageCoopClientDir)/RageCoop.Client.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="RageCoop.Core"><HintPath>$(RageCoopServerDir)/RageCoop.Core.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="ScriptHookVDotNet3"><HintPath>$(RageCoopServerDir)/ScriptHookVDotNet3.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Lidgren.Network"><HintPath>$(RageCoopClientDir)/Lidgren.Network.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="LemonUI.SHVDN3"><HintPath>$(LemonUiDll)</HintPath><Private>true</Private></Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <Target Name="RequireBuiltClientResource" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(ClientResourcePath)')" Text="Build the Client resource in this configuration before running EngineComposition; this check loads the actual built DLL without recompiling its guards." />
  </Target>
</Project>
