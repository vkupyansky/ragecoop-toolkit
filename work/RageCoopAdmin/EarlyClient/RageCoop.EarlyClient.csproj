<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AssemblyName>CoopControl.EarlyClient</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.3" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Compile Include="../Client/EngineIngressGuard.cs" Link="EngineIngressGuard.cs" />
    <Reference Include="RageCoop.Client"><HintPath>$(RageCoopClientDir)/RageCoop.Client.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RageCoop.Core"><HintPath>$(RageCoopServerDir)/RageCoop.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ScriptHookVDotNet3"><HintPath>$(RageCoopServerDir)/ScriptHookVDotNet3.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Lidgren.Network"><HintPath>$(RageCoopClientDir)/Lidgren.Network.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
